{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADM-BE",
  "version": "1.0.1",
  "identifier": "com.adm.be",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ADM-BE",
        "width": 1440,
        "height": 800,
        "center": true,
        "minWidth": 1440,
        "minHeight": 800,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "ADM-BE - 大模型部署图形化管理工具",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}